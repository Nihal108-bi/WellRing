# ============================================
# WellRing Backend — Environment Variables
# Copy this file to .env and fill in real values
# ============================================

# --- Application ---
APP_ENV=development
BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Database (Supabase Postgres or local) ---
# For local docker-compose: postgresql+asyncpg://wellring:wellring@localhost:5432/wellring
DATABASE_URL=postgresql+asyncpg://wellring:wellring@localhost:5432/wellring

# --- Redis (Upstash or local) ---
# For local docker-compose: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# --- Auth (Clerk) ---
# Get from https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# --- Telephony (Twilio) ---
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_me
TWILIO_PHONE_NUMBER=+15551234567
TELEPHONY_PROVIDER=twilio

# --- Exotel (India production — leave blank for now) ---
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=

# --- AI Services (Phase 1 will use these) ---
DEEPGRAM_API_KEY=replace_me
GROQ_API_KEY=replace_me
ANTHROPIC_API_KEY=sk-ant-replace_me
ELEVENLABS_API_KEY=replace_me
CARTESIA_API_KEY=replace_me

# --- Observability ---
SENTRY_DSN=